# ---- Server ----
PORT=5000
NODE_ENV=development
# Allowed origin of the React dev server (only needed in development)
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local MongoDB (Compass / mongod) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/marketlink

# ---- Auth ----
# Change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Currency symbol used in e-mails, notifications and the assistant
CURRENCY=Rs

# Time zone of the markets (pickup slots and cut-off times use it)
TZ=Asia/Karachi

# ---- E-mail notifications (optional) ----
# Leave SMTP_HOST empty to print e-mails to the server console instead of sending them.
# Set SMTP_HOST=ethereal to get a free test inbox (a link to view every e-mail is printed).
# For real e-mails use your provider, e.g. SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 and a Gmail app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MarketLink <no-reply@marketlink.local>"
